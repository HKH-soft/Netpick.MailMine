# Server Configuration
SERVER_PORT=8080

# Database Configuration
DATABASE_NAME=netpick
POSTGRES_URL=postgres:5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_this_secure_password

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change_this_secure_password

# Email Configuration
GMAIL_USERNAME=your_email
GMAIL_PASSWORD=change_this_secure_password
# JWT Configuration
JWT_SECRET_KEY="change_this_secure_key"
JWT_ISSUER="netpick"

# External APIs
GEMINI_API_KEY=change_this_secure_key

# AI Provider Configuration
AI_PROVIDER=gemini
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# CORS Configuration
CORS_ALLOWED_ORIGINS="*"
CORS_ALLOWED_METHODS="*"
CORS_ALLOWED_HEADERS="*"
CORS_EXPOSED_HEADERS="*"

# Xray Configuration
XRAY_EXECUTABLE_PATH="/app/xray/xray"

# Monitoring
ACTUATOR_USERNAME=change_this_secure_username
ACTUATOR_PASSWORD=change_this_secure_password